# For running the web app outside Docker (`npm run dev`). Copy to `web/.env.local`.
# Point Postgres and rustfs at whatever you have running — the compose file at the repo
# root can supply both: `docker compose up -d postgres rustfs`.

# The ports match the host side of the root compose file, which stays off 5432/9000 so
# it does not collide with a Postgres or MinIO/rustfs you already run.
DATABASE_URL=postgres://pptgo:pptgo@localhost:5433/pptgo

# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Authorised redirect URI in the Google console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=pptgo
S3_ACCESS_KEY_ID=pptgoadmin
S3_SECRET_ACCESS_KEY=pptgoadmin
