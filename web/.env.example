# For running the web app outside Docker (`npm run dev`). Copy to `web/.env.local`.
# Point Postgres and rustfs at whatever you have running — the compose file at the repo
# root can supply both: `docker compose up -d postgres rustfs`.
#
# If you are using those containers, the credentials below are NOT guessable defaults any
# more: the root `.env` carries the ones compose was started with (generated by
# `./scripts/gen-secrets.sh`), and these have to match it or the connection is refused.
# Copy POSTGRES_PASSWORD, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY across from there.
#
# The ports match the host side of the root compose file, which stays off 5432/9000 so it
# does not collide with a Postgres or MinIO/rustfs you already run, and binds them to
# 127.0.0.1 — so this only works from the same machine, which is the point.

# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgres://pptgo:@localhost:5433/pptgo

# openssl rand -base64 32 — this one is yours alone; it need not match the root .env
AUTH_SECRET=
# The public origin people actually reach — https://pptgo.dev on the hosted
# instance, your own domain when self-hosting. Google compares it against the
# redirect URI, and it is also what the MCP preview links and the endpoint printed
# on /mcp are built from: leave it at a container-internal name and both point
# somewhere nobody else can open.
AUTH_URL=http://localhost:3000
# Authorised redirect URI in the Google console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=pptgo
# both must match the root .env
S3_ACCESS_KEY_ID=pptgo
S3_SECRET_ACCESS_KEY=
