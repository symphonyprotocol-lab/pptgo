# Copy to `.env` next to docker-compose.yml, then fill in the three blanks below.
# `docker compose up` refuses to start until they are set — none of them has a default,
# because a default secret printed in a public repository is the same as no secret.
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh            # fills the blanks in place
#
# Or by hand: `openssl rand -base64 32` for AUTH_SECRET and `openssl rand -hex 24` for
# the other two (POSTGRES_PASSWORD goes into a URL, so keep it out of `/@:?#`).

# Signs the session cookie. Keep it stable — changing it signs everyone out.
AUTH_SECRET=

# ── Google 登录 / Google sign-in ──────────────────────────────────────────────
# Leave blank to bring the stack up without sign-in: the landing page and the
# browser-local editor at /editor still work, and /login says what is missing.
#
# https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The origin users type into the browser. Must match the redirect URI above.
AUTH_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pptgo
POSTGRES_PASSWORD=
POSTGRES_DB=pptgo

# ── rustfs (S3-compatible object storage) ─────────────────────────────────────
S3_BUCKET=pptgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pptgo
S3_SECRET_ACCESS_KEY=

# ── ports on the host ─────────────────────────────────────────────────────────
# Only WEB_PORT matters for using the app. Postgres and rustfs are published so that
# `npm run dev` outside Docker can reach the same services — that is a local convenience,
# not a service anyone else should be able to reach, so they bind to 127.0.0.1. Widen a
# bind only if you mean it: POSTGRES_BIND=0.0.0.0 puts your database on the internet.
#
# The ports stay off 5432/9000/9001 on purpose — those are the first ports an existing
# Postgres or MinIO/rustfs grabs, and a collision there stops `docker compose up` dead.
# Inside the network the containers still use their standard ports.
WEB_PORT=3000
WEB_BIND=0.0.0.0
POSTGRES_PORT=5433
POSTGRES_BIND=127.0.0.1
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
RUSTFS_BIND=127.0.0.1

# The rustfs web console is a second, human-facing door onto the same bucket. It is on
# because it binds to loopback; set it to false if you would rather it did not exist.
RUSTFS_CONSOLE_ENABLE=true

# ── deployed servers only ─────────────────────────────────────────────────────
# Which build of the web image to run. The deploy workflow writes the tag it just pushed
# into this line, so the server can explain itself: `docker compose up -d` typed by hand
# brings up the same version, and a rollback is this line changed and that one command.
#
# Leave it out and compose builds from ./web, which is what a clone should do.
# WEB_IMAGE=ghcr.io/symphonyprotocol-lab/pptgo/web:0123456789ab
