# Copy to `.env` next to docker-compose.yml. AUTH_SECRET is the only value that must be
# filled in before `docker compose up`; everything else has a working local default.
#
#   cp .env.example .env
#   sed -i '' "s|^AUTH_SECRET=$|AUTH_SECRET=$(openssl rand -base64 32)|" .env   # macOS
#   sed -i    "s|^AUTH_SECRET=$|AUTH_SECRET=$(openssl rand -base64 32)|" .env   # Linux

# Signs the session cookie. Keep it stable — changing it signs everyone out.
AUTH_SECRET=

# ── Google 登录 ───────────────────────────────────────────────────────────────
# Leave blank to bring the stack up without sign-in: the landing page and the
# browser-local editor at /editor still work, and /login says what is missing.
#
# https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The origin users type into the browser. Must match the redirect URI above.
AUTH_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pptgo
POSTGRES_PASSWORD=pptgo
POSTGRES_DB=pptgo

# ── rustfs (S3-compatible object storage) ─────────────────────────────────────
S3_BUCKET=pptgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pptgoadmin
S3_SECRET_ACCESS_KEY=pptgoadmin

# ── ports on the host ─────────────────────────────────────────────────────────
# Only WEB_PORT matters for using the app; the other three are published so that
# `npm run dev` outside Docker can reach the same services. They stay off 5432/9000/9001
# on purpose — those are the first ports an existing Postgres or MinIO/rustfs grabs, and
# a collision there stops `docker compose up` dead. Inside the network the containers
# still use their standard ports.
WEB_PORT=3000
POSTGRES_PORT=5433
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
